<!DOCTYPE html>
<html lang="en">
<head>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 20px;
        }
        h1 {
            color: #333;
        }
    </style>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
</head>
<body>

    <!-- <h1>Hey from server</h1>
    <% urls.forEach((url) => { %>
    <li><%= url.shortId %> → <%= url.redirectURL %></li>
<% }); %> -->

    <h1>URL Shortener</h1>
    
    <% if(locals.shortId) %>
    <p> URL Generated : http://localhost/url/<%=shortId %> </p>
    <div>
        <form method="POST" action="/url">
            <label for="originalUrl">Enter URL to shorten:</label>
            <input 
            type="text" 
            name="url"
            placeholder="Enter URL" />
            <button type="submit">Generate</button>
        </form>
    </div>
</body>
</html>